{
  "name": "@justbuilt/copier",
  "version": "0.1.0",
  "description": "Copier: a copy-to-clipboard button as a desktop photocopier. Ships as a web component and a React component on one framework-free engine.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Justyna Dabrowska",
  "homepage": "https://photo-copier.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justynabuilds/copier.git"
  },
  "bugs": {
    "url": "https://github.com/justynabuilds/copier/issues"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "react",
    "copy-to-clipboard",
    "clipboard",
    "photocopier",
    "animation",
    "ui-component",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "main": "./dist/copier.js",
  "module": "./dist/copier.js",
  "types": "./dist/types/element/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/element/index.d.ts",
      "import": "./dist/copier.js",
      "default": "./dist/copier.iife.js"
    },
    "./react": "./src/react/Copier.tsx",
    "./core": "./src/core/machine.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --port 4177",
    "build": "vite build && tsc -p tsconfig.types.json",
    "build:site": "vite build --config vite.site.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
